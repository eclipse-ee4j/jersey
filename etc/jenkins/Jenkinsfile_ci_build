pipeline {
    agent none

    environment {
        MAVEN_OPTS = "-Xms1g -Xmx2g -Xss512k -XX:MaxGCPauseMillis=200 -XX:+UseShenandoahGC -XX:+UseStringDeduplication"
    }

    options {
          disableConcurrentBuilds()
          buildDiscarder(logRotator(numToKeepStr:'15', artifactNumToKeepStr: '2' ))
          timeout(time: 300, activity: true, unit: 'MINUTES')
    }

    stages {
        stage('Jersey build') {
            parallel {
                stage('JDK 17') {
                    agent any
                    tools {
                        jdk 'temurin-jdk17-latest'
                        maven 'apache-maven-latest'
                    }
                    steps {
                        sh '''
                                mvn -B -e -ntp clean install -DskipTests -T4C # Fastest possible check
                                mvn -B -e -ntp clean install -Dcheckstyle.skip=true
                            '''
                    }
                }
                stage('JDK 25') {
                    agent any
                    tools {
                        jdk 'temurin-jdk25-latest'
                        maven 'apache-maven-latest'
                    }
                    steps {
                        sh '''
                                mvn -B -e -ntp clean install -DskipTests -T4C # Fastest possible check
                                mvn -B -e -ntp clean verify -f tests/version-agnostic -Djersey.version=4.0.99-SNAPSHOT # Check for version irregularities
                                mvn -B -e -ntp clean install -Dcheckstyle.skip=true
                                echo "*** If dependency convergence fails, try to exclude some dependencies you don't need, or override them. ***"
                                export EXCLUDE_ARGS=''
                                bash ${WORKSPACE}/etc/scripts/validation/dependency-convergence.sh
                            '''
                    }
                }
            }
        }
    }
}
